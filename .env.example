# OneCompilerHub — Environment Configuration
# Copy this file to .env.local and fill in your Supabase credentials

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (Safe for browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Server-side ONLY, NEVER commit or expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL for Auth Redirects (Local development: http://localhost:3000, Production: https://one-compiler-hub.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
