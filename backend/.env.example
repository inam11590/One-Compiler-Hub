# OneCompilerHub Execution Backend Configuration
PROJECT_NAME="OneCompilerHub Execution API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Security Killswitch: Set to true to enable Python code execution in local/staging sandboxes
EXECUTION_ENABLED=true
MOCK_WORKER_ENABLED=false

# Supabase Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# CORS Allowed Origins (Comma-separated in production or list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://one-compiler-hub.vercel.app"]

# Rate Limiting
RATE_LIMIT_ANON_PER_MINUTE=15
RATE_LIMIT_AUTH_PER_MINUTE=60

# Queue
QUEUE_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0
